# --- data and artifacts: NEVER committed ---
# Canonical-format datasets, raw downloads, feature caches, run outputs.
# These are large (IPN Hand alone is ~800k frames) and are reproducible from
# scripts/ + configs/. See CLAUDE.md §4.
#
# Leading slashes are load-bearing: an unanchored `data/` matches at ANY depth and
# would silently exclude src/data/, the most important package in the repo.
/data/**
/raw/
# The downloaded archives themselves. 28 GB of zips sitting in the working tree is one
# stray `git add .` away from a very bad afternoon.
/IPN hand Dataset/
/runs/
/outputs/
/checkpoints/
/wandb/
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.tfevents.*

# Exception: the frozen split files. Everything else under data/ is a regenerable cache,
# but a frozen split is the evidence behind Hard Rule 3 -- it is what lets a reader (or an
# examiner) confirm that the split behind a reported number never moved. It is a few KB of
# JSON and it belongs in version control, not in a cache directory.
!/data/*/
!/data/*/splits/
!/data/*/splits/*.json

# Exception: hand-made fixtures that cannot be regenerated from a script.
!tests/fixtures/**
!tests/fixtures/**/*.npy

# ...but not the generated synthetic dataset. The test suite builds its own copy in a
# tmp dir, so committing this one would be half a megabyte of binaries that nothing
# reads. Regenerate it with: python scripts/make_fixture.py --force
tests/fixtures/synthetic/

# The author's private study material. The repository is public, and prose the author
# will draw on when writing the thesis must not be somewhere a similarity checker can
# match the thesis against it -- the same reason log.md lives outside the repo.
/reports/private/

# Rendered sample clips. Megabytes of GIF, regenerable with
# scripts/make_sample_clip.py, so kept out of history.
/reports/samples/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- editors / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- secrets ---
.env
*.key
credentials.json
